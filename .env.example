# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Used when GEMINI_API_KEY is empty.
# GOOGLE_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional thinking effort: low, medium, or high. Defaults to low.
# medium and high on gemini-3.8-flash can run past the request deadline.
GEMINI_THINKING_LEVEL=low

# Optional request timeout in seconds. Defaults to 60.
# This only stops a hung request. It does not make Gemini answer faster.
GEMINI_TIMEOUT_SECONDS=60

# MongoDB connection string for POST /documents. Include the database in the path,
# or set MONGODB_DB. Example: mongodb://localhost:27017
MONGODB_URI=

# Database name. Defaults to document_analyzer when the URI has no database path.
MONGODB_DB=document_analyzer
